# 数据缓存(体积大, 可重新拉取)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/

# 书籍/大文件
*.pdf

# OS
.DS_Store

# 生产机运行日志与本地回滚副本
logs/
*.bak*

# tushare token(私密)
config/tushare_token.txt

# polygon 代理 key(私密)
config/polygon_key.txt

# 部署产物(由 build_site.py 从 reports/ 生成)
site/
